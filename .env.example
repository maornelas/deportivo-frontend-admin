# URL base del API (incluye /api/v1).
# Producción / build: URL absoluta del backend.
# VITE_API_URL=https://tu-api.ejemplo.com/api/v1
#
# Si existe `.env.development.local`, Vite lo mezcla en `npm run dev` y
# las variables repetidas AHÍ GANAN sobre este archivo (.env).
#
# Desarrollo contra API remoto (evita CORS): en `.env.development.local`:
#   VITE_API_URL=/api/v1
#   VITE_DEV_PROXY_TARGET=https://tu-api.ejemplo.com:3000
# El navegador pide http://localhost:5173/api/v1/... y Vite reenvía al servidor.
# Recomendado en local: URL relativa + proxy de Vite (evita errores CORS con :5173 → :3000).
#   VITE_API_URL=/api/v1
#   VITE_DEV_PROXY_TARGET=http://localhost:3000
# Si usas URL absoluta a :3000, el navegador hace cross-origin y necesitas CORS impecable en el backend.
VITE_API_URL=

# Solo desarrollo: destino del proxy cuando VITE_API_URL es relativo (/api/v1).
# VITE_DEV_PROXY_TARGET=http://localhost:3000

# Google Maps JavaScript API (módulo Repartidor — recorrido). Restringe la clave por HTTP referrer.
# VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Tutoriales (panel): JSON array de { "title", "src" (URL HTTPS del .mp4 en S3), "description" opcional }.
# Ejemplo (una línea): VITE_ADMIN_TUTORIAL_VIDEOS_JSON=[{"title":"Demo","src":"https://bucket.s3.region.amazonaws.com/admin/tutoriales/demo.mp4"}]
# VITE_ADMIN_TUTORIAL_VIDEOS_JSON=
