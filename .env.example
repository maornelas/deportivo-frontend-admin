# URL base del API (incluye /api/v1).
# Producción / build: URL absoluta del backend.
# VITE_API_URL=https://tu-api.ejemplo.com/api/v1
#
# Desarrollo local contra un API remoto (evita error CORS en el navegador):
# crea `.env.development.local` con:
#   VITE_API_URL=/api/v1
#   VITE_DEV_PROXY_TARGET=https://tu-api.ejemplo.com:3000
# Así el navegador llama a http://localhost:5173/api/v1/... y Vite reenvía al servidor.
VITE_API_URL=

# Solo desarrollo: destino del proxy cuando VITE_API_URL es relativo (/api/v1).
# VITE_DEV_PROXY_TARGET=http://localhost:3000

# Google Maps JavaScript API (módulo Repartidor — recorrido). Restringe la clave por HTTP referrer.
# VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
